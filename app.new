# --- REEMPLAZA TUS IMPORTACIONES VIEJAS POR ESTAS ---
from langchain_chroma import Chroma
# Reemplazo para PDFPlumberLoader (langchain-community está obsoleta)
from langchain_community.document_loaders import PyPDFLoader 
from langchain_ollama import OllamaEmbeddings

# --- CONFIGURACIÓN CORRECTA DE EMBEDDINGS ---
# Asegúrate de haber ejecutado antes en tu terminal: ollama run nomic-embed-text
embeddings = OllamaEmbeddings(model="nomic-embed-text")

# --- CONFIGURACIÓN CORRECTA DEL VECTOR STORE ---
# Usando la nueva clase oficial de langchain-chroma
db_directory = "./chroma_db" # Tu ruta asignada
vector_store = Chroma(
    persist_directory=db_directory, 
    embedding_function=embeddings
)

# --- TU FUNCIÓN DE INDEXACIÓN ---
def index_docs(documents):                                                       
    vector_store.add_documents(documents)                                        
    # Nota: vector_store.persist() ya no es necesario en las nuevas versiones de Chroma,
    # se guarda en disco de forma automática al añadir documentos.

#-----------------------------------------------------------------
# fx para cargar o subir los pdf
pdfs_directory = 'pdfs/'

def upload_pdf(file):
    with open(pdfs_directory + file.name, "wb") as f:
        f.write(file.getbuffer())

# fx para cargar o leer un pdf        
def load_pdf(file_path):
    loader = PDFPlumberLoader(file_path)
    documents = loader.load()
    return documents

# toma el pdf y lo divide en trozos o partes mas pequeñas
def split_text(documents):
    text_splitter = RecursiveCharacterTextSplitter(
        chunk_size=1000, #caracteres
        chunk_overlap=200, #traslapar => contexto chunk anterior
        add_start_index=True # agrega el indice inicial al texto original
    )
    return text_splitter.split_documents(documents)

# guardar los documentos o embedding y se guardan en el disco
def index_docs(documents):
    vector_store.add_documents(documents)
    vector_store.persist()

# recibe la pregunta del usuario y busqueda por similitud
def retrieve_docs(query):
    return vector_store.similarity_search(query)

# toma la pregunta y los documentos y entrega la respuesta
def answer_question(question, documents):
    context = "\n\n".join([doc.page_content for doc in documents])
    prompt = ChatPromptTemplate.from_template(template)
    chain = prompt | model
    return chain.invoke({"question": question, "context": context})
#-----------------------------------------------------------------
# st (Grafica)
uploaded_file = st.file_uploader(
    "Subir PDF",
    type="pdf",
    accept_multiple_files=False
)

if uploaded_file:
    upload_pdf(uploaded_file)
    documents = load_pdf(pdfs_directory + uploaded_file.name)
    chunked_documents = split_text(documents)
    index_docs(chunked_documents)

    question = st.chat_input("Escribe tu pregunta aqui...")
    if question:
        st.chat_message("user".write(question))
        related_documents = retrieve_docs(question)
        answer = answer_question(question, related_documents)
        st.chat_message("assistant").write(answer)